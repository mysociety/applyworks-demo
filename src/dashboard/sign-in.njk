---
layout: default.njk
title: Sign in
---

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/password-input/macro.njk" import govukPasswordInput %}

{% call govukFieldset({
  legend: {
    text: "Sign in to manage your applications",
    classes: "govuk-fieldset__legend--l",
    isPageHeading: true
  },
  classes: "govuk-!-width-one-half"
}) %}

  {{ govukInput({
    label: {
      text: "Email address"
    },
    id: "username",
    name: "username",
    autocomplete: "username",
    attributes: {
      "data-st8-key": "user-email"
    }
  }) }}

  {{ govukPasswordInput({
    label: {
      text: "Password"
    },
    id: "password",
    name: "password",
    value: "applyworks is awesome",
    autocomplete: "password"
  }) }}

{% endcall %}

{{ govukButton({
  text: "Sign in",
  href: "/dashboard",
  classes: "js-sign-in"
}) }}
