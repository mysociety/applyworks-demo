---
layout: default.njk
title: Previous street trading consent – Apply for a street trading licence
---

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

<span class="govuk-caption-m govuk-!-margin-bottom-3">
  Applicant: <span data-st8-key="user-name"></span>
</span>

{# Rendered twice, because each radio’s conditional needs its own copy of the field #}
{% macro consentDetails(id) %}
  {{ govukTextarea({
    label: {
      text: "Please provide a reference number, or the site and dates of the consent"
    },
    id: id,
    name: "current-consent-details",
    attributes: {
      "data-st8-key": "current-consent-details"
    }
  }) }}
{% endmacro %}

{{ govukRadios({
  name: "current-consent",
  classes: "govuk-!-width-two-thirds",
  fieldset: {
    legend: {
      text: "Do you currently have street trading consent in this borough?",
      isPageHeading: true,
      classes: "govuk-fieldset__legend--l"
    }
  },
  items: [
    {
      value: "Yes",
      text: "Yes",
      conditional: {
        html: consentDetails("current-consent-details")
      },
      attributes: {
        "data-st8-key": "current-consent"
      }
    },
    {
      value: "No, but I have previously had it",
      text: "No, but I have previously had it",
      conditional: {
        html: consentDetails("previous-consent-details")
      },
      attributes: {
        "data-st8-key": "current-consent"
      }
    },
    {
      value: "No, I have never had street trading consent in this borough",
      text: "No, I have never had street trading consent in this borough",
      attributes: {
        "data-st8-key": "current-consent"
      }
    }
  ]
}) }}

{{ govukButton({
  text: "Continue",
  href: "/street-trading/refused-consent"
}) }}
