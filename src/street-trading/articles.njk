---
layout: default.njk
title: Articles for sale – Apply for a street trading licence
---

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<span class="govuk-caption-m govuk-!-margin-bottom-3">
  Apply for a street trading licence
</span>

<h1 class="govuk-heading-l">Articles for sale</h1>

<p class="govuk-body readable">Select everything you plan to sell. If something you sell is not listed, choose “Other” in the closest category and tell us what it is.</p>

{{ govukInput({
  label: {
    text: "Search articles"
  },
  classes: "govuk-!-width-one-half",
  type: "search",
  id: "articles-search",
  name: "articles-search",
  autocomplete: "off",
  spellcheck: false,
  attributes: {
    "data-filter-target": ".js-article-group"
  }
}) }}

<p class="govuk-body govuk-!-margin-bottom-6 js-filter-no-results" hidden>No articles match your search.</p>

{% for category in articles %}

  {% set items = [] %}
  {% for article in category.items %}
    {% if article.other %}
      {% set otherHtml %}
        {{ govukInput({
          label: {
            text: "What other " + (category.name | lower) + " will you sell?"
          },
          id: article.slug + "-details",
          name: article.slug + "-details",
          attributes: {
            "data-st8-key": article.slug + "-details"
          }
        }) }}
      {% endset %}
    {% endif %}
    {% set items = (items.push({
      value: article.text,
      text: article.text,
      id: article.slug,
      conditional: { html: otherHtml } if article.other else undefined,
      attributes: {
        "data-st8-key": article.slug
      }
    }), items) %}
  {% endfor %}

  {{ govukCheckboxes({
    name: "articles-" + category.slug,
    idPrefix: "articles-" + category.slug,
    classes: "govuk-checkboxes--small",
    formGroup: {
      classes: "govuk-!-width-two-thirds js-article-group"
    },
    fieldset: {
      legend: {
        text: category.name,
        classes: "govuk-fieldset__legend--s"
      }
    },
    items: items
  }) }}

{% endfor %}

<div class="sticky-actions">
  {{ govukButton({
    text: "Continue",
    href: "/street-trading/declaration"
  }) }}
</div>
