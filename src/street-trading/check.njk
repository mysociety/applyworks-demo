---
layout: default.njk
title: Check your answers – Apply for a street trading licence
---

{% from "govuk/components/button/macro.njk" import govukButton %}

<span class="govuk-caption-m govuk-!-margin-bottom-3">
  Apply for a street trading licence
</span>

<h1 class="govuk-heading-l govuk-!-margin-bottom-6">Check your answers before sending your application</h1>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% set showChangeLinks = true %}
    {% include "street-trading-answers.njk" %}

    <h2 class="govuk-heading-m govuk-!-margin-top-9">Now send your application</h2>

    <p class="govuk-body">By submitting this application you are confirming that, to the best of your knowledge, the details you are providing are correct.</p>

    {{ govukButton({
      text: "Submit application",
      href: "/street-trading/success",
      classes: "js-submit-street-trading"
    }) }}

  </div>
</div>
