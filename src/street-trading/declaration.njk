        "data-st8-key": "declaration-correct"
      }
    },
    {
      value: "conditions",
      text: "I/we am/are aware of the Council’s Standard Conditions applicable to all Street Trading Consents and agree to comply with them.",
      attributes: {
        "data-st8-key": "declaration-conditions"
      }
    },
    {
      value: "public-notice",
      text: "I understand that, upon submission of the application, I/we must affix the prescribed Public Notice (provided by the Council) in the proposed trading location, for a period of 28 days, and that this must remain in place until the application has been determined.",
      attributes: {
        "data-st8-key": "declaration-public-notice"
      }
    }
  ]
}) }}

{{ govukButton({
  text: "Continue",
