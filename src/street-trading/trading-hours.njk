---
layout: default.njk
title: Trading hours – Apply for a street trading licence
---

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<span class="govuk-caption-m govuk-!-margin-bottom-3">
  Apply for a street trading licence
</span>

{% call govukFieldset({
  legend: {
    text: "Trading hours",
    classes: "govuk-fieldset__legend--l",
    isPageHeading: true
  },
  describedBy: "trading-hours-hint",
  classes: "govuk-!-width-one-half"
}) %}

  <div id="trading-hours-hint" class="govuk-hint">
    At what times do you propose to trade? Leave both times blank for any days you will not be trading.
  </div>

  <table class="govuk-table govuk-table--align-middle">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">Day</th>
        <th scope="col" class="govuk-table__header">Start</th>
        <th scope="col" class="govuk-table__header">End</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for day in ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] %}
        {% set key = "hours-" + (day | lower) %}
        <tr class="govuk-table__row">
          <th scope="row" class="govuk-table__header">{{ day }}</th>
          {% for time in ["start", "end"] %}
            <td class="govuk-table__cell">
              {{ govukInput({
                label: {
                  text: day + " " + time + " time",
                  classes: "govuk-visually-hidden"
                },
                formGroup: {
                  classes: "govuk-!-margin-bottom-0"
                },
                classes: "govuk-input--width-5",
                id: key + "-" + time,
                name: key + "-" + time,
                attributes: {
                  "data-st8-key": key + "-" + time
                }
              }) }}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

{% endcall %}

{{ govukButton({
  text: "Continue",
  href: "/street-trading/articles"
}) }}
