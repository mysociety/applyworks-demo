---
layout: default.njk
title: Trading site address – Apply for a street trading licence
---

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<span class="govuk-caption-m govuk-!-margin-bottom-3">
  Apply for a street trading licence
</span>

{% call govukFieldset({
  legend: {
    text: "Trading site address",
    classes: "govuk-fieldset__legend--l",
    isPageHeading: true
  },
  classes: "govuk-!-width-one-half"
}) %}

  {{ govukInput({
    label: {
      text: "Address line 1"
    },
    id: "site-address-line-1",
    name: "site-address-line-1",
    autocomplete: "address-line1",
    attributes: {
      "data-st8-key": "site-address-line-1"
    }
  }) }}

  {{ govukInput({
    label: {
      text: "Address line 2 (optional)"
    },
    id: "site-address-line-2",
    name: "site-address-line-2",
    autocomplete: "address-line2",
    attributes: {
      "data-st8-key": "site-address-line-2"
    }
  }) }}

  {{ govukInput({
    label: {
      text: "Town or city"
    },
    classes: "govuk-!-width-two-thirds",
    id: "site-address-town",
    name: "site-address-town",
    autocomplete: "address-level2",
    attributes: {
      "data-st8-key": "site-address-town"
    }
  }) }}

  {{ govukInput({
    label: {
      text: "County (optional)"
    },
    classes: "govuk-!-width-two-thirds",
    id: "site-address-county",
    name: "site-address-county",
    attributes: {
      "data-st8-key": "site-address-county"
    }
  }) }}

  {{ govukInput({
    label: {
      text: "Postcode"
    },
    classes: "govuk-input--width-10",
    id: "site-postcode",
    name: "site-postcode",
    autocomplete: "postal-code",
    attributes: {
      "data-st8-key": "site-postcode"
    }
  }) }}

{% endcall %}

{{ govukButton({
  text: "Continue",
  href: "/street-trading/fixed/stall"
}) }}
